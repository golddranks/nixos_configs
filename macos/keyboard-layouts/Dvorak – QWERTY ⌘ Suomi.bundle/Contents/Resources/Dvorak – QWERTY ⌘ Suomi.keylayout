<keyboard group="0" id="-23364" name="Dvorak – QWERTY ⌘ Suomi" maxout="1">
    <layouts>
        <!-- https://groups.google.com/g/ukelele-users/c/Zg6owIiVWVc -->
        <layout first="0" last="0" mapSet="base" modifiers="mods"/>
        <layout first="18" last="18" mapSet="xtend" modifiers="mods"/>
        <layout first="21" last="23" mapSet="xtend" modifiers="mods"/>
        <layout first="30" last="30" mapSet="xtend" modifiers="mods"/>
        <layout first="194" last="194" mapSet="xtend" modifiers="mods"/>
        <layout first="197" last="197" mapSet="xtend" modifiers="mods"/>
        <layout first="200" last="201" mapSet="xtend" modifiers="mods"/>
        <layout first="206" last="207" mapSet="xtend" modifiers="mods"/>
    </layouts>
    <modifierMap id="mods" defaultIndex="0">
        <!-- normal typing (plain, shift, caps; shift subsumes caps), without Option -->
        <keyMapSelect mapIndex="0">
            <modifier keys=""/>
        </keyMapSelect>
        <keyMapSelect mapIndex="1">
            <modifier keys="anyShift caps?"/>
        </keyMapSelect>
        <keyMapSelect mapIndex="2">
            <modifier keys="caps"/>
        </keyMapSelect>
        <!-- normal typing (plain, shift, caps; shift subsumes caps), special characters with Option -->
        <keyMapSelect mapIndex="3">
            <modifier keys="anyOption"/>
        </keyMapSelect>
        <keyMapSelect mapIndex="4">
            <modifier keys="anyShift caps? anyOption"/>
        </keyMapSelect>
        <keyMapSelect mapIndex="5">
            <modifier keys="caps anyOption"/>
        </keyMapSelect>
        <!-- ASCII control keys (control overrides other modifiers): Dvorak layout -->
        <keyMapSelect mapIndex="6">
            <modifier keys="anyShift? caps? anyOption? anyControl"/>
        </keyMapSelect>
        <!-- Command without Shift: QWERTY layout -->
        <keyMapSelect mapIndex="7">
            <modifier keys="caps? anyOption? command anyControl?"/>
        </keyMapSelect>
        <!-- Command with Shift: QWERTY layout -->
        <keyMapSelect mapIndex="8">
            <modifier keys="anyShift caps? anyOption? command anyControl?"/>
        </keyMapSelect>
    </modifierMap>
