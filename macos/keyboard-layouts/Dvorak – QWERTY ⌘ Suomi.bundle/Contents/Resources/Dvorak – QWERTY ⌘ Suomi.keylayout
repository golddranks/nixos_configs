    <actions>
        <action id="a_A">
            <when state="none" output="A"/>
            <when state="s_acute" output="Á"/>
            <when state="s_circumflex" output="Â"/>
            <when state="s_grave" output="À"/>
            <when state="s_macron" output="Ā"/>
            <when state="s_tilde" output="Ã"/>
            <when state="s_twodots" output="Ä"/>
        </action>
        <action id="a_E">
            <when state="none" output="E"/>
            <when state="s_acute" output="É"/>
            <when state="s_circumflex" output="Ê"/>
            <when state="s_grave" output="È"/>
            <when state="s_macron" output="Ē"/>
            <when state="s_twodots" output="Ë"/>
        </action>
        <action id="a_I">
            <when state="none" output="I"/>
            <when state="s_acute" output="Í"/>
            <when state="s_circumflex" output="Î"/>
            <when state="s_grave" output="Ì"/>
            <when state="s_macron" output="Ī"/>
            <when state="s_twodots" output="Ï"/>
        </action>
        <action id="a_N">
            <when state="none" output="N"/>
            <when state="s_tilde" output="Ñ"/>
        </action>
        <action id="a_O">
            <when state="none" output="O"/>
            <when state="s_acute" output="Ó"/>
            <when state="s_circumflex" output="Ô"/>
            <when state="s_grave" output="Ò"/>
            <when state="s_macron" output="Ō"/>
            <when state="s_tilde" output="Õ"/>
            <when state="s_twodots" output="Ö"/>
        </action>
        <action id="a_U">
            <when state="none" output="U"/>
            <when state="s_acute" output="Ú"/>
            <when state="s_circumflex" output="Û"/>
            <when state="s_grave" output="Ù"/>
            <when state="s_macron" output="Ū"/>
            <when state="s_twodots" output="Ü"/>
        </action>
        <action id="a_Y">
            <when state="none" output="Y"/>
            <when state="s_macron" output="Ȳ"/>
            <when state="s_twodots" output="Ÿ"/>
        </action>
        <action id="a_a">
            <when state="none" output="a"/>
            <when state="s_acute" output="á"/>
            <when state="s_circumflex" output="â"/>
            <when state="s_grave" output="à"/>
            <when state="s_macron" output="ā"/>
            <when state="s_tilde" output="ã"/>
            <when state="s_twodots" output="ä"/>
        </action>
        <action id="a_acute">
            <when state="none" next="s_acute"/>
        </action>
        <action id="a_circumflex">
            <when state="none" next="s_circumflex"/>
        </action>
        <action id="a_e">
            <when state="none" output="e"/>
            <when state="s_acute" output="é"/>
            <when state="s_circumflex" output="ê"/>
            <when state="s_grave" output="è"/>
            <when state="s_macron" output="ē"/>
            <when state="s_twodots" output="ë"/>
        </action>
        <action id="a_grave">
            <when state="none" next="s_grave"/>
        </action>
        <action id="a_i">
            <when state="none" output="i"/>
            <when state="s_acute" output="í"/>
            <when state="s_circumflex" output="î"/>
            <when state="s_grave" output="ì"/>
            <when state="s_macron" output="ī"/>
            <when state="s_twodots" output="ï"/>
        </action>
        <action id="a_macron">
            <when state="none" next="s_macron"/>
        </action>
        <action id="a_n">
            <when state="none" output="n"/>
            <when state="s_tilde" output="ñ"/>
        </action>
        <action id="a_o">
            <when state="none" output="o"/>
            <when state="s_acute" output="ó"/>
            <when state="s_circumflex" output="ô"/>
            <when state="s_grave" output="ò"/>
            <when state="s_macron" output="ō"/>
            <when state="s_tilde" output="õ"/>
            <when state="s_twodots" output="ö"/>
        </action>
        <action id="a_space">
            <when state="none" output=" "/>
            <when state="s_acute" output="´"/>
            <when state="s_circumflex" output="ˆ"/>
            <when state="s_grave" output="`"/>
            <when state="s_tilde" output="˜"/>
            <when state="s_twodots" output="¨"/>
        </action>
        <action id="a_tilde">
            <when state="none" next="s_tilde"/>
        </action>
        <action id="a_twodots">
            <when state="none" next="s_twodots"/>
        </action>
        <action id="a_u">
            <when state="none" output="u"/>
            <when state="s_acute" output="ú"/>
            <when state="s_circumflex" output="û"/>
            <when state="s_grave" output="ù"/>
            <when state="s_macron" output="ū"/>
            <when state="s_twodots" output="ü"/>
        </action>
        <action id="a_y">
            <when state="none" output="y"/>
            <when state="s_macron" output="ȳ"/>
            <when state="s_twodots" output="ÿ"/>
        </action>
        <action id="m">
            <when state="none" output="m"/>
            <when state="s_macron" output="m"/>
        </action>
        <action id="v">
            <when state="none" output="v"/>
            <when state="s_macron" output="v"/>
        </action>
    </actions>
    <terminators>
        <when state="s_acute" output="´"/>
        <when state="s_circumflex" output="ˆ"/>
        <when state="s_grave" output="`"/>
        <when state="s_macron" output="¯"/>
        <when state="s_tilde" output="˜"/>
        <when state="s_twodots" output="¨"/>
    </terminators>
</keyboard>
